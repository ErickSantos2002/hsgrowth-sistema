# ==================== STAGE 1: Builder ====================
FROM python:3.11-slim AS builder

# Define build arguments
ARG ENVIRONMENT=production

# Evita prompts durante build
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Instala dependências do sistema necessárias para build
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Cria diretório de trabalho
WORKDIR /app

# Copia apenas requirements primeiro (melhor cache do Docker)
COPY requirements-prod.txt .

# Instala dependências Python em um virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Instala dependências em etapas para melhor debugging
RUN echo "=== Atualizando pip, setuptools e wheel ===" && \
    pip install --upgrade pip setuptools wheel

RUN echo "=== Instalando dependências core ===" && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    python-multipart==0.0.6

RUN echo "=== Instalando dependências de banco de dados ===" && \
    pip install --no-cache-dir \
    sqlalchemy==2.0.25 \
    alembic==1.13.1 \
    psycopg2-binary==2.9.9

RUN echo "=== Instalando outras dependências ===" && \
    pip install --no-cache-dir -r requirements-prod.txt


# ==================== STAGE 2: Runtime ====================
FROM python:3.11-slim

# Define build arguments
ARG ENVIRONMENT=production

# Variáveis de ambiente
# XDG_CACHE_HOME: diretório de cache gravável p/ fontconfig (WeasyPrint roda como appuser, não-root)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    XDG_CACHE_HOME=/tmp/.cache \
    ENVIRONMENT=${ENVIRONMENT}

# Instala apenas dependências runtime necessárias
# (inclui libs de sistema do WeasyPrint: pango/cairo/gdk-pixbuf + fontes — geração de PDF das propostas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    curl \
    redis-tools \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    libffi8 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Cria usuário não-root para segurança
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Cria diretórios necessários
WORKDIR /app
RUN mkdir -p /app/logs /app/backups && \
    chown -R appuser:appuser /app

# Copia virtual environment do builder
COPY --from=builder /opt/venv /opt/venv

# Copia código da aplicação
COPY --chown=appuser:appuser . .

# Muda para usuário não-root
USER appuser

# Expõe porta da API
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Torna o script de inicialização executável
RUN chmod +x /app/scripts/start.sh || true

# Limpa cache do Python
RUN find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type f -name "*.pyc" -delete 2>/dev/null || true

# Comando padrão
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
